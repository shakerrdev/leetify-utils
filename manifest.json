{
  "manifest_version": 2,
  "name": "Leetify Rank Tracker",
  "version": "1.0",
  "description": "Displays rank changes on Leetify match pages",
  "permissions": [
    "https://api.cs-prod.leetify.com/*",
    "webRequest"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://leetify.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}